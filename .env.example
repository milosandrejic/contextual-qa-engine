# App
APP_NAME=Contextual QA Engine
DEBUG=true

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/contextual_qa

# Retrieval
RETRIEVAL_MODE=hybrid  # semantic | lexical | hybrid

# Reranking (Cohere cross-encoder)
COHERE_API_KEY=your-cohere-api-key-here
RERANKER_MODEL=rerank-english-v3.0
RERANKER_CANDIDATE_K=20  # candidate pool fetched before reranking

# Conversation
MAX_HISTORY_MESSAGES=20

# CORS (JSON array of allowed origins)
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LangSmith (optional tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=contextual-qa-engine
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

